# Copy to .env at the repo root. Do not commit .env.

APP_ENV=local
API_KEY=dev-local-key

# APP_ENV=local|dev|test enables GET /v1/devices/{id}/dev/totp-setup,
# POST /v1/devices/{id}/dev/totp-rotate, and scripts/print_device_totp.py.
# Use production (or any other value) so that TOTP secrets are never served.
# Do not display secrets in production UI.

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=dev-webhook-secret

# Sentry / Datadog webhook HMAC secrets (R01)
SENTRY_WEBHOOK_SECRET=
DATADOG_WEBHOOK_SECRET=

# Database / queue
# Local Compose uses pgvector/pgvector:pg16 so native pgvector can be enabled.
DATABASE_URL=postgresql+psycopg://autopatch:autopatch@localhost:5432/autopatch
REDIS_URL=redis://localhost:6379/0

# E2B
E2B_API_KEY=
# Custom template with iptables + mkfs/mount (built via backend/scripts/build_e2b_template.py)
E2B_TEMPLATE=autopatch-sandbox

# Temporary audit stop. Leave unset/false in production.
# When true, clone_and_index records ReproductionAttempt then finishes
# without generate_patch / patch_review / PR.
AUTOPATCH_STOP_AFTER_REPRO=false

# LLM (LiteLLM). Required for patch generation and embeddings.
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_API_BASE=
EMBEDDING_MODEL=text-embedding-3-small

# Gemini (backend only). Loaded from backend/.env via app.config.Settings.
# Never send this key to the Android app or web frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Firebase Admin (path to service account JSON)
GOOGLE_APPLICATION_CREDENTIALS=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=dev-local-key
